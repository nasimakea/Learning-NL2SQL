[ 2026-04-11 23:10:28,039 ] 33 src.pipeline.chat_pipeline - INFO - Raw response: ```sql
WITH TopPayingPatients AS (
    SELECT
        p.id AS patient_id,
        p.first_name,
        p.last_name,
        SUM(i.paid_amount) AS total_paid_amount
    FROM patients p
    JOIN invoices i ON p.id = i.patient_id
    GROUP BY p.id, p.first_name, p.last_name
    ORDER BY total_paid_amount DESC
    LIMIT 10
)
SELECT
    tpp.first_name,
    tpp.last_name,
    tpp.total_paid_amount,
    GROUP_CONCAT(DISTINCT tr.treatment_name, '; ') AS received_treatments
FROM TopPayingPatients tpp
LEFT JOIN appointments a ON tpp.patient_id = a.patient_id
LEFT JOIN treatments tr ON a.id = tr.appointment_id
GROUP BY
    tpp.patient_id,
    tpp.first_name,
    tpp.last_name,
    tpp.total_paid_amount
ORDER BY
    tpp.total_paid_amount DESC;
```
